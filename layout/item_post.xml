<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- En-tête du post -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgPostAuthorAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPostAuthorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auteur"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPostTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="À l'instant"
                    android:textColor="#777777"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/ibEditPost"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Modifier"
                android:src="@android:drawable/ic_menu_edit"
                android:visibility="gone"
                app:tint="#777777" />

            <ImageButton
                android:id="@+id/ibDeletePost"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Supprimer"
                android:src="@android:drawable/ic_menu_delete"
                android:visibility="gone"
                app:tint="#777777" />

        </LinearLayout>

        <!-- Texte de la publication -->
        <TextView
            android:id="@+id/tvPostContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Image de la publication agrandie avec support contenu sensible -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutPostImageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgPostImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="420dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:id="@+id/layoutSensitiveOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#DD212121"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Contenu sensible"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Cette image a été marquée comme sensible. Cliquez pour l'afficher."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRevealSensitive"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Afficher"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Vidéo de la publication -->
        <FrameLayout
            android:id="@+id/layoutPostVideo"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgPostVideoThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/ibPlayPostVideo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/badge_background"
                android:backgroundTint="#80000000"
                android:padding="12dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="#FFFFFF" />

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Zone des réactions (Like, Commenter, Partager, Signaler) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLikePost"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:paddingHorizontal="1dp"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="👍 J'aime" />

            <Button
                android:id="@+id/btnCommentPost"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:paddingHorizontal="1dp"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="💬" />

            <Button
                android:id="@+id/btnSharePost"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:paddingHorizontal="1dp"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Partager" />

            <Button
                android:id="@+id/btnReportPost"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:paddingHorizontal="1dp"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Signaler" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvLikesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0 Reaction(s)"
            android:textColor="#555555"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
