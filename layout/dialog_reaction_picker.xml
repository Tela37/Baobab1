<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/reaction_pill_background"
    android:elevation="12dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/btnReactLike"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="👍"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/btnReactLove"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="❤️"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/btnReactCare"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="🥰"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/btnReactHaha"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="😄"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/btnReactWow"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="😮"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/btnReactSad"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="😢"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/btnReactAngry"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="😡"
        android:textSize="28sp" />

</LinearLayout>
