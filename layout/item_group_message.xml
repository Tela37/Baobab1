<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutMessageContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgSenderAvatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <LinearLayout
            android:id="@+id/layoutBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/message_received_background"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nom de l'auteur"
                android:textColor="#2196F3"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgGroupMessagePhoto"
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:layout_marginTop="4dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/layoutGroupVideoContainer"
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgGroupVideoThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="#80000000"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_media_play" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/layoutGroupFileContainer"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#E3F2FD"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tvGroupFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:text="Document.pdf"
                    android:textColor="#0D47A1"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAudioContainer"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/ibAudioPlay"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/circle_background"
                    android:contentDescription="Lecture audio"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#2196F3" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:contentDescription="Onde sonore"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_waveform"
                    app:tint="#2196F3" />

                <TextView
                    android:id="@+id/tvAudioDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0:00"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvGroupMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Message de groupe"
                android:textColor="#000000"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGroupMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:text="12:00"
                android:textColor="#888888"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
