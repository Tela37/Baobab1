<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarUser2Page"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#2E7D32"
        android:visibility="gone"
        app:title="Page de l'utilisateur"
        app:titleTextColor="#FFFFFF" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- 1. Cover Photo & 2. Profile Avatar Header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <!-- Cover Image -->
                <ImageView
                    android:id="@+id/imgUser2Cover"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:background="#2196F3"
                    android:contentDescription="Photo de couverture"
                    android:scaleType="centerCrop" />

                <!-- Profile Avatar overlapping cover with Story Ring & Status Indicator -->
                <FrameLayout
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="5dp">

                    <!-- Outer ring for Story indicator (blue when has story) -->
                    <View
                        android:id="@+id/viewStoryRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#2196F3"
                        android:visibility="gone" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfileUserAvatar"
                        android:layout_width="122dp"
                        android:layout_height="122dp"
                        android:layout_gravity="center"
                        android:background="@color/white"
                        android:padding="3dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                    <!-- Online / Last seen time badge (e.g. 4 heures) -->
                    <TextView
                        android:id="@+id/tvUser2LastSeen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/comment_input_background"
                        android:backgroundTint="#E8F5E9"
                        android:elevation="4dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="Actif"
                        android:textColor="#2E7D32"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </FrameLayout>

            <!-- 3. Name, Bio & 4, 8. Stats (Amis, Publications) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProfileUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nom de l'utilisateur"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUser2Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text=" 🔵"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvUser2Bio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Bio / Devise"
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvUser2StatsSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0 ami(e)s • 0 publications"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 6. Action Buttons: Message & Ami(e)s / Ajouter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnUser2AddFriend"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="👤 Ajouter"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnUser2Message"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#2196F3"
                        android:text="💬 Message"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 7. Quick Info / En un coup d'œil (Ville, profession, téléphone, etc. avec masquage si privé) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En un coup d'œil 📌"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUser2Location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="10dp"
                        android:text="Habite à..."
                        android:textColor="#444444"
                        android:textSize="14sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_compass" />

                    <TextView
                        android:id="@+id/tvUser2Profession"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="10dp"
                        android:text="Profession..."
                        android:textColor="#444444"
                        android:textSize="14sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_agenda" />

                    <TextView
                        android:id="@+id/tvUser2Dob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="10dp"
                        android:text="Né(e) le..."
                        android:textColor="#444444"
                        android:textSize="14sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_my_calendar" />

                    <TextView
                        android:id="@+id/tvUser2Phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="10dp"
                        android:text="Téléphone..."
                        android:textColor="#444444"
                        android:textSize="14sp"
                        app:drawableStartCompat="@android:drawable/ic_menu_call" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Post Creation Box (Écrire sur le profil) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <EditText
                        android:id="@+id/etPostContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:drawable/editbox_background_normal"
                        android:hint="@string/publier_sur_ce_profil"
                        android:inputType="textMultiLine"
                        android:minHeight="80dp"
                        android:padding="10dp"
                        android:textSize="14sp" />

                    <!-- Aperçu de l'image sélectionnée -->
                    <RelativeLayout
                        android:id="@+id/layoutSelectedImage"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/imgSelectedPostImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <ImageButton
                            android:id="@+id/btnRemoveSelectedImage"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:layout_margin="8dp"
                            android:background="@drawable/badge_background"
                            android:backgroundTint="#99000000"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="#FFFFFF" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/ibAttachImage"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Joindre une photo"
                            android:src="@android:drawable/ic_menu_gallery"
                            app:tint="#2196F3" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/btnPublishPost"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:backgroundTint="#2196F3"
                            android:text="Publier"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Titre Section Publications -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="Publications"
                android:textColor="#2E7D32"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Liste des publications (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUserPosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_post" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
